# Solo desarrollo local. Reemplazar todos los valores antes de otro entorno.
LOCAL_VIDEO_DEPLOYMENT=local
LOCAL_VIDEO_POSTGRES_PORT=54329
LOCAL_VIDEO_POSTGRES_HOST=127.0.0.1
LOCAL_VIDEO_POSTGRES_DB=local_video
LOCAL_VIDEO_POSTGRES_USER=local_video
LOCAL_VIDEO_POSTGRES_PASSWORD=replace-with-local-only-password
# Alternativa para secret mounts: LOCAL_VIDEO_POSTGRES_PASSWORD_FILE=C:\ruta\absoluta\password
LOCAL_VIDEO_POSTGRES_POOL_MAX=5
LOCAL_VIDEO_POSTGRES_SSL_MODE=disable
# Remoto: verify-full y CA opcional si no usa la confianza del sistema.
# LOCAL_VIDEO_DATABASE_URL=postgresql://host/database
# LOCAL_VIDEO_POSTGRES_SSL_CA_FILE=C:\ruta\absoluta\postgres-ca.pem

LOCAL_VIDEO_S3_PORT=8333
LOCAL_VIDEO_S3_PROVIDER=seaweedfs
LOCAL_VIDEO_S3_ENDPOINT=http://127.0.0.1:8333
LOCAL_VIDEO_S3_ACCESS_KEY=replace-with-local-only-access-key
LOCAL_VIDEO_S3_SECRET_KEY=replace-with-local-only-secret-key
# Alternativas: LOCAL_VIDEO_S3_ACCESS_KEY_FILE y LOCAL_VIDEO_S3_SECRET_KEY_FILE
LOCAL_VIDEO_S3_CREDENTIALS=static
LOCAL_VIDEO_S3_BUCKET=local-video-private
LOCAL_VIDEO_S3_REGION=us-east-1
LOCAL_VIDEO_S3_FORCE_PATH_STYLE=true
LOCAL_VIDEO_S3_MAX_SOCKETS=8
# Remoto: endpoint HTTPS o proveedor aws-s3 con credenciales ambient.
# LOCAL_VIDEO_S3_TLS_CA_FILE=C:\ruta\absoluta\s3-ca.pem
LOCAL_VIDEO_PERSISTENCE=postgres-s3
