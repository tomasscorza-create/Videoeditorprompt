{
  "name": "disenador-videos-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node scripts/test-core.mjs",
    "dev": "node scripts/local-app/dev.mjs",
    "dev:web": "vite",
    "local:server": "node scripts/local-app/server.mjs",
    "build": "tsc && vite build",
    "stage1:assets": "node scripts/stage1/generate-assets.mjs",
    "stage1:prepare": "node scripts/stage1/prepare-scene.mjs --job-id=preview",
    "stage1:export": "node scripts/stage1/export-scene.mjs --job-id=preview",
    "stage1:verify": "node scripts/stage1/verify-stage1.mjs --job-id=preview",
    "stage1:pipeline": "node scripts/stage1/pipeline.mjs --job-id=preview --publish-dir=public/generated",
    "stage1:test-jobs": "node scripts/stage1/test-two-jobs.mjs",
    "stage1:test-config": "node scripts/stage1/test-config-validation.mjs",
    "stage2b:test-preview": "node scripts/stage1/test-preview-publishing.mjs",
    "stage2c:assets": "node scripts/stage2c/generate-monkey-character.mjs",
    "stage2c:test-rig": "node scripts/stage1/test-character-rig.mjs",
    "stage2d:test-contract": "node scripts/stage1/test-dialogue-contract.mjs",
    "stage2d:pipeline": "node scripts/stage1/pipeline.mjs --job-id=piloto-dialogo-monos-01 --config=pilots/dialogo-monos-01/scene.config.json --assets-dir=public --publish-dir=public/generated",
    "stage2e:assets": "node scripts/stage2e/generate-background-layers.mjs",
    "stage2e:test-background": "node scripts/stage1/test-background-animation.mjs",
    "stage2e:pipeline": "node scripts/stage1/pipeline.mjs --job-id=piloto-fondo-parallax-01 --config=pilots/fondo-parallax-01/scene.config.json --assets-dir=public --publish-dir=public/generated",
    "stage2f:assets": "node scripts/stage2c/generate-monkey-character.mjs --variant=analista",
    "stage2f:test-quality": "node scripts/stage1/test-mouth-quality.mjs",
    "stage2f:pipeline": "node scripts/stage1/pipeline.mjs --job-id=piloto-calidad-dialogo-01 --config=pilots/calidad-dialogo-01/scene.config.json --assets-dir=public --publish-dir=public/generated",
    "stage2f:parametric-assets": "node scripts/stage2f/generate-parametric-character.mjs --assets-dir=public --definition=assets/character-definitions/mono-parametrico-v1.json --output-base=assets/characters --catalog=assets/catalog/index.json",
    "stage2f:test-parametric": "node scripts/stage2f/test-parametric-character.mjs",
    "stage2f:parametric-pipeline": "node scripts/stage1/pipeline.mjs --job-id=piloto-parametrico-01 --config=pilots/parametric-character-01/scene.config.json --assets-dir=public --publish-dir=public/generated",
    "stage3a:validate-project": "node scripts/stage3a/validate-video-project.mjs --project=pilots/proyecto-editable-01/project.json --assets-dir=public",
    "stage3a:test-project": "node scripts/stage3a/test-video-project.mjs",
    "stage3a:compile-project": "node scripts/stage3a/compile-video-project.mjs --job-id=proyecto-compilable-01 --project=pilots/proyecto-compilable-01/project.json --assets-dir=public",
    "stage3a:test-compiler": "node scripts/stage3a/test-project-compiler.mjs",
    "stage3a:test-assembly": "node scripts/stage3a/test-project-assembly.mjs",
    "stage3a:project-pipeline": "node scripts/stage3a/project-pipeline.mjs --job-id=piloto-multiescena-02 --project=pilots/proyecto-compilable-01/project.json --assets-dir=public",
    "stage3b:test-editor": "node scripts/stage3b/test-project-editor.mjs",
    "stage3b:publish-project": "node scripts/stage3b/publish-project.mjs --project=pilots/proyecto-compilable-01/project.json --assets-dir=public --publish-dir=public/projects",
    "stage3b:test-publishing": "node scripts/stage3b/test-project-publishing.mjs",
    "stage3b:test-contracts": "node scripts/stage3b/test-contract-compatibility.mjs",
    "director:test-plan": "node scripts/director/test-director-plan.mjs",
    "director:test-ollama": "node scripts/director/test-ollama-director.mjs",
    "director:test-editor": "node scripts/director/test-project-editor-director.mjs",
    "director:test-provider-contract": "node scripts/director/test-provider-contract.mjs",
    "local:test-server": "node scripts/local-app/test-server.mjs",
    "local:test-library": "node scripts/local-app/test-resource-library.mjs",
    "local:test-projects": "node scripts/local-app/test-project-repository.mjs",
    "local:test-render-manager": "node scripts/local-app/test-render-job-manager.mjs",
    "local:test-retention": "node scripts/local-app/test-retention.mjs",
    "storage:test-filesystem": "node scripts/storage/test-filesystem-adapters.mjs",
    "ui:test-modules": "node scripts/ui/test-ui-modules.mjs",
    "local:clean": "node scripts/local-app/retention.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
