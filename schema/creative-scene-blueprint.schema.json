{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/creative-scene-blueprint-v1.json",
  "title": "Blueprint semántico de escena flexible V1",
  "description": "Contrato aislado de V0. Describe intención, participantes, voz y recetas; todavía no es un runtime renderizable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sceneId",
    "mode",
    "durationWeight",
    "sceneRecipeId",
    "participants",
    "visualElements",
    "speech",
    "effectSequences"
  ],
  "properties": {
    "version": { "const": 1 },
    "sceneId": { "$ref": "#/$defs/id" },
    "mode": { "$ref": "#/$defs/sceneMode" },
    "durationWeight": {
      "description": "Peso editorial relativo. No es una duración real ni estimada.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "sceneRecipeId": { "$ref": "#/$defs/id" },
    "participants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/participant" }
    },
    "visualElements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/visualElement" }
    },
    "speech": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/spokenTurn" }
    },
    "effectSequences": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/effectSequenceRequest" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "sceneMode": {
      "enum": ["voiceover", "solo", "dialogue", "visual-with-voiceover"]
    },
    "pace": {
      "enum": ["slow", "normal", "fast"]
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "characterResourceId", "voiceId", "narrativeRole", "animationPresetId"],
      "properties": {
        "roleId": { "$ref": "#/$defs/id" },
        "characterResourceId": { "$ref": "#/$defs/id" },
        "voiceId": { "$ref": "#/$defs/id" },
        "narrativeRole": { "$ref": "#/$defs/shortText" },
        "animationPresetId": { "$ref": "#/$defs/id" }
      }
    },
    "visualElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "type", "resourceId", "purpose"],
      "properties": {
        "roleId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["prop", "template"] },
        "resourceId": { "$ref": "#/$defs/id" },
        "purpose": { "$ref": "#/$defs/shortText" }
      }
    },
    "spokenTurn": {
      "oneOf": [
        { "$ref": "#/$defs/characterTurn" },
        { "$ref": "#/$defs/voiceoverTurn" }
      ]
    },
    "characterTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "speakerRoleId", "voiceId", "text", "pace", "gapAfterSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "character" },
        "speakerRoleId": { "$ref": "#/$defs/id" },
        "voiceId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "pace": { "$ref": "#/$defs/pace" },
        "gestureId": { "$ref": "#/$defs/id" },
        "gestureAtWord": { "type": "integer", "minimum": 0, "maximum": 199 },
        "gapAfterSeconds": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "voiceoverTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "voiceId", "text", "pace", "gapAfterSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "voiceover" },
        "voiceId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "pace": { "$ref": "#/$defs/pace" },
        "gapAfterSeconds": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "edge"],
          "properties": {
            "kind": { "const": "scene" },
            "edge": { "enum": ["start", "end"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "turnId", "edge"],
          "properties": {
            "kind": { "const": "turn" },
            "turnId": { "$ref": "#/$defs/id" },
            "edge": { "enum": ["start", "end"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "turnId", "wordIndex"],
          "properties": {
            "kind": { "const": "word" },
            "turnId": { "$ref": "#/$defs/id" },
            "wordIndex": { "type": "integer", "minimum": 0, "maximum": 199 }
          }
        }
      ]
    },
    "effectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "elementRoleId"],
      "properties": {
        "slotId": { "$ref": "#/$defs/id" },
        "elementRoleId": { "$ref": "#/$defs/id" }
      }
    },
    "effectSequenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequenceId", "anchor", "intensity", "durationScale", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "intensity": { "enum": ["soft", "medium", "strong"] },
        "durationScale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/effectBinding" }
        }
      }
    }
  }
}
