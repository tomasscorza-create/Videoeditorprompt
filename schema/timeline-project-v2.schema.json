{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/timeline-project-v2.json",
  "title": "Timeline profesional de clips V2",
  "description": "Contrato no destructivo del espacio Montaje. video-project.schema.json conserva la autoría semántica y sus renders medidos entran aquí como fuentes inmutables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "timebase", "sources", "tracks", "clips"],
  "properties": {
    "version": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "timebase": { "$ref": "#/$defs/timebase" },
    "sources": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/source" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/track" }
    },
    "clips": {
      "type": "array",
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/clip" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticksPerSecond", "fps", "audioSampleRate"],
      "properties": {
        "ticksPerSecond": { "const": 48000 },
        "fps": { "const": 30 },
        "audioSampleRate": { "const": 48000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "durationTicks", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["visual", "dialogue-audio", "audio", "video"] },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 1728000000 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["visual", "audio"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceId", "trackId", "timelineStartTick", "sourceInTick", "durationTicks", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["visual", "audio"] },
        "sourceId": { "$ref": "#/$defs/id" },
        "trackId": { "$ref": "#/$defs/id" },
        "timelineStartTick": { "type": "integer", "minimum": 0, "maximum": 1728000000 },
        "sourceInTick": { "type": "integer", "minimum": 0, "maximum": 1728000000 },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 1728000000 },
        "enabled": { "type": "boolean" },
        "linkGroupId": { "$ref": "#/$defs/id" },
        "automation": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/automationTrack" }
        }
      }
    },
    "automationTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterId", "keyframes"],
      "properties": {
        "parameterId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$"
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/keyframe" }
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceTick", "value", "interpolation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceTick": { "type": "integer", "minimum": 0, "maximum": 1728000000 },
        "value": { "type": "number" },
        "interpolation": { "enum": ["linear", "ease", "hold"] }
      }
    }
  }
}
