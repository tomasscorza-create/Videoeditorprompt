{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/local-data-bundle-v1.json",
  "title": "Bundle portable de datos locales",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "format",
    "fingerprint",
    "policy",
    "summary",
    "entries"
  ],
  "properties": {
    "version": { "const": 1 },
    "format": { "const": "local-video-data-bundle" },
    "fingerprint": { "$ref": "#/$defs/hash" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedJobStates", "artifactPolicy", "excluded"],
      "properties": {
        "includedJobStates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "completed" }],
          "items": false
        },
        "artifactPolicy": { "const": "all-final-output-files" },
        "excluded": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "resources",
        "resourceFiles",
        "jobs",
        "jobArtifacts",
        "totalFiles",
        "totalBytes"
      ],
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "resources": { "type": "integer", "minimum": 0 },
        "resourceFiles": { "type": "integer", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "jobArtifacts": { "type": "integer", "minimum": 0 },
        "totalFiles": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\:/][^\\\\:]*$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "path", "bytes", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "project",
            "resource-registry",
            "resource-asset",
            "job-record",
            "job-artifact"
          ]
        },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "path": { "$ref": "#/$defs/portablePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/hash" },
        "jobId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
