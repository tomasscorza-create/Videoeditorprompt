{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/resource-license-manifest-v1.json",
  "title": "Manifiesto legal de recursos incorporados",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "catalog", "policy", "resources", "dependencies"],
  "properties": {
    "version": { "const": 1 },
    "catalog": { "$ref": "#/$defs/portablePath" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rightsHolder", "proprietaryAssetLicense", "notices"],
      "properties": {
        "rightsHolder": { "$ref": "#/$defs/nonEmpty" },
        "proprietaryAssetLicense": { "const": "LicenseRef-Proprietary-Asset" },
        "notices": { "$ref": "#/$defs/portablePath" }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/resourceRecord" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/dependencyRecord" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,127}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 500 },
    "webUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 1000 },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "status": { "enum": ["cleared", "attribution-required", "review-required", "local-only"] },
    "commercialUse": { "enum": ["allowed", "prohibited", "review-required", "plan-dependent"] },
    "redistribution": { "enum": ["allowed", "allowed-with-notice", "product-only", "prohibited", "review-required", "not-applicable"] },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "text": { "$ref": "#/$defs/nonEmpty" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } } },
          "then": {
            "required": ["text"],
            "properties": { "text": { "$ref": "#/$defs/nonEmpty" } }
          }
        }
      ]
    },
    "legalFields": {
      "type": "object",
      "required": ["licenseExpression", "status", "commercialUse", "redistribution", "attribution", "notes"],
      "properties": {
        "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 200 },
        "licenseUrl": { "$ref": "#/$defs/webUrl" },
        "status": { "$ref": "#/$defs/status" },
        "commercialUse": { "$ref": "#/$defs/commercialUse" },
        "redistribution": { "$ref": "#/$defs/redistribution" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "notes": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "resourceRecord": {
      "allOf": [
        { "$ref": "#/$defs/legalFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceId", "assetType", "origin", "rightsHolder", "licenseExpression", "status", "commercialUse", "redistribution", "attribution", "notes"],
          "properties": {
            "resourceId": { "$ref": "#/$defs/id" },
            "assetType": { "enum": ["character", "prop", "template", "voice", "background", "image", "music"] },
            "origin": { "enum": ["original", "third-party", "ai-assisted", "user-created"] },
            "rightsHolder": { "$ref": "#/$defs/nonEmpty" },
            "sourceUrl": { "$ref": "#/$defs/webUrl" },
            "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 200 },
            "licenseUrl": { "$ref": "#/$defs/webUrl" },
            "status": { "$ref": "#/$defs/status" },
            "commercialUse": { "$ref": "#/$defs/commercialUse" },
            "redistribution": { "$ref": "#/$defs/redistribution" },
            "attribution": { "$ref": "#/$defs/attribution" },
            "notes": { "$ref": "#/$defs/nonEmpty" }
          },
          "allOf": [
            {
              "if": { "properties": { "origin": { "const": "third-party" } } },
              "then": {
                "required": ["sourceUrl", "licenseUrl"],
                "properties": {
                  "sourceUrl": { "$ref": "#/$defs/webUrl" },
                  "licenseUrl": { "$ref": "#/$defs/webUrl" }
                }
              }
            }
          ]
        }
      ]
    },
    "dependencyRecord": {
      "allOf": [
        { "$ref": "#/$defs/legalFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "sourceUrl", "licenseExpression", "licenseUrl", "status", "commercialUse", "redistribution", "attribution", "notes"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "$ref": "#/$defs/nonEmpty" },
            "kind": { "enum": ["runtime", "service"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 80 },
            "sourceUrl": { "$ref": "#/$defs/webUrl" },
            "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 200 },
            "licenseUrl": { "$ref": "#/$defs/webUrl" },
            "status": { "$ref": "#/$defs/status" },
            "commercialUse": { "$ref": "#/$defs/commercialUse" },
            "redistribution": { "$ref": "#/$defs/redistribution" },
            "attribution": { "$ref": "#/$defs/attribution" },
            "notes": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    }
  }
}
