{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/asset-catalog-v1.json",
  "title": "Catálogo local de assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedFrom", "entries"],
  "properties": {
    "version": { "const": 1 },
    "generatedFrom": { "$ref": "#/$defs/assetPath" },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "label", "manifest", "thumbnail", "tags", "capabilities", "provenance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "const": "character" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "manifest": { "$ref": "#/$defs/assetPath" },
          "thumbnail": { "$ref": "#/$defs/assetPath" },
          "tags": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
          "capabilities": {
            "type": "object", "additionalProperties": false, "required": ["poses", "mouthStates", "joints"],
            "properties": {
              "poses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "mouthStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "joints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            }
          },
          "provenance": {
            "type": "object", "additionalProperties": false, "required": ["source", "license"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 300 },
              "license": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "assetPath": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
