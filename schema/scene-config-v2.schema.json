{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/scene-config-v2.json",
  "title": "Escena única con diálogo medido",
  "description": "Contrato cerrado de dos personajes y turnos secuenciales compilados desde audio real.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "video", "assets", "characters", "dialogue", "mouth", "subtitleStyle"],
  "properties": {
    "version": { "const": 2 },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background"],
      "properties": {
        "background": { "$ref": "#/$defs/assetPath" }
      }
    },
    "backgroundAnimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "camera"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "asset", "baseScale", "parallaxX", "parallaxY"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "asset": { "$ref": "#/$defs/assetPath" },
              "baseScale": { "type": "number", "minimum": 1, "maximum": 1.5 },
              "parallaxX": { "type": "number", "minimum": 0, "maximum": 2 },
              "parallaxY": { "type": "number", "minimum": 0, "maximum": 2 }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromX", "toX", "fromY", "toY", "fromZoom", "toZoom"],
          "properties": {
            "fromX": { "type": "number", "minimum": -200, "maximum": 200 },
            "toX": { "type": "number", "minimum": -200, "maximum": 200 },
            "fromY": { "type": "number", "minimum": -200, "maximum": 200 },
            "toY": { "type": "number", "minimum": -200, "maximum": 200 },
            "fromZoom": { "type": "number", "minimum": 1, "maximum": 1.3 },
            "toZoom": { "type": "number", "minimum": 1, "maximum": 1.3 }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "characterManifest", "transform", "blink"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "characterManifest": { "$ref": "#/$defs/assetPath" },
          "transform": { "$ref": "#/$defs/characterTransform" },
          "blink": { "$ref": "#/$defs/blink" }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speakerId", "text", "voice", "gapAfterSeconds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "speakerId": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "voice": { "$ref": "#/$defs/voice" },
          "gesture": { "enum": ["neutral", "point"] },
          "gapAfterSeconds": { "type": "number", "minimum": 0, "maximum": 5 }
        }
      }
    },
    "mouth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowMs", "smoothing", "silenceThresholdNormalized", "openThresholdNormalized", "minStateDurationMs"],
      "properties": {
        "windowMs": { "type": "integer", "minimum": 10, "maximum": 100 },
        "smoothing": { "type": "number", "minimum": 0, "maximum": 0.99 },
        "silenceThresholdNormalized": { "type": "number", "minimum": 0, "maximum": 1 },
        "openThresholdNormalized": { "type": "number", "minimum": 0, "maximum": 1 },
        "minStateDurationMs": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "subtitleStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontSize", "bottomMargin"],
      "properties": {
        "fontSize": { "type": "integer", "minimum": 8, "maximum": 200 },
        "bottomMargin": { "type": "integer", "minimum": 0, "maximum": 1920 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "lengthScale", "volume"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
        "lengthScale": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "characterTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromX", "toX", "baseY", "entrySeconds", "bobAmplitude", "bobPeriodSeconds", "baseScale", "scalePulse"],
      "properties": {
        "fromX": { "type": "number", "minimum": -4320, "maximum": 4320 },
        "toX": { "type": "number", "minimum": -4320, "maximum": 4320 },
        "baseY": { "type": "number", "minimum": -3840, "maximum": 3840 },
        "entrySeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "bobAmplitude": { "type": "number", "minimum": 0, "maximum": 1920 },
        "bobPeriodSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "baseScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "scalePulse": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "blink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "firstSeconds", "minIntervalSeconds", "maxIntervalSeconds", "durationSeconds"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "firstSeconds": { "type": "number", "minimum": 0, "maximum": 3600 },
        "minIntervalSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "maxIntervalSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      }
    }
  }
}
