{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/scene-config-v2.json",
  "title": "Escena única con diálogo medido",
  "description": "Contrato cerrado de cero a dos personajes y turnos secuenciales de personaje o voz fuera de campo, compilados desde audio real.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "video",
    "assets",
    "characters",
    "dialogue",
    "mouth",
    "subtitleStyle"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "const": 30
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/assetPath"
        },
        "music": {
          "$ref": "#/$defs/assetPath"
        }
      }
    },
    "assetCatalog": {
      "$ref": "#/$defs/assetPath"
    },
    "backgroundAnimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "camera"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "asset",
              "baseScale",
              "parallaxX",
              "parallaxY"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "asset": {
                "$ref": "#/$defs/assetPath"
              },
              "baseScale": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.5
              },
              "parallaxX": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "parallaxY": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromX",
            "toX",
            "fromY",
            "toY",
            "fromZoom",
            "toZoom"
          ],
          "properties": {
            "fromX": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "toX": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "fromY": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "toY": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "fromZoom": {
              "type": "number",
              "minimum": 1,
              "maximum": 1.3
            },
            "toZoom": {
              "type": "number",
              "minimum": 1,
              "maximum": 1.3
            }
          }
        }
      }
    },
    "backgroundVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "poster", "durationSeconds", "fps", "loop"],
      "properties": {
        "asset": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "type": "string", "pattern": "\\.mp4$" }] },
        "poster": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "type": "string", "pattern": "\\.(png|jpg|jpeg)$" }] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "fps": { "const": 30 },
        "loop": { "const": true }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transform",
          "blink"
        ],
        "oneOf": [
          {
            "properties": {
              "characterManifest": {
                "$ref": "#/$defs/assetPath"
              }
            },
            "required": [
              "characterManifest"
            ]
          },
          {
            "properties": {
              "characterAssetId": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "characterAssetId"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "characterManifest": {
            "$ref": "#/$defs/assetPath"
          },
          "characterAssetId": {
            "$ref": "#/$defs/id"
          },
          "transform": {
            "$ref": "#/$defs/characterTransform"
          },
          "blink": {
            "$ref": "#/$defs/blink"
          },
          "tracks": {
            "$ref": "#/$defs/animationTracks"
          },
          "visibility": {
            "$ref": "#/$defs/visibilityWindow"
          }
        }
      }
    },
    "props": {
      "type": "array",
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resourceManifest",
          "transform"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "resourceManifest": {
            "$ref": "#/$defs/assetPath"
          },
          "transform": {
            "$ref": "#/$defs/propTransform"
          },
          "tracks": {
            "$ref": "#/$defs/animationTracks"
          },
          "visibility": {
            "$ref": "#/$defs/visibilityWindow"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "description": "Efectos prearmados que se componen por código. Repiten su ciclo mientras dura la escena y solo los dibuja el compositor PixiJS.",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "definition",
          "word",
          "transform"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "definition": {
            "$ref": "#/$defs/assetPath"
          },
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "transform": {
            "$ref": "#/$defs/propTransform"
          },
          "visibility": {
            "$ref": "#/$defs/visibilityWindow"
          }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "voice",
          "gapAfterSeconds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "speakerType": {
            "enum": [
              "character",
              "voiceover"
            ]
          },
          "speakerId": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "voice": {
            "$ref": "#/$defs/voice"
          },
          "gesture": {
            "enum": [
              "neutral",
              "point",
              "celebrate",
              "doubt",
              "deny"
            ]
          },
          "gestureAtWord": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "layout": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/turnLayout"
            }
          },
          "gapAfterSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "soundEffects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset", "anchor", "offsetSeconds", "gainDb"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "asset": { "$ref": "#/$defs/assetPath" },
          "anchor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "edge"],
                "properties": { "kind": { "const": "scene" }, "edge": { "enum": ["start", "end"] } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "turnId", "edge"],
                "properties": {
                  "kind": { "const": "turn" },
                  "turnId": { "$ref": "#/$defs/id" },
                  "edge": { "enum": ["start", "end"] }
                }
              }
            ]
          },
          "offsetSeconds": { "type": "number", "minimum": -5, "maximum": 5 },
          "gainDb": { "type": "number", "minimum": -30, "maximum": 6 }
        }
      }
    },
    "mouth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowMs",
        "smoothing",
        "silenceThresholdNormalized",
        "openThresholdNormalized",
        "minStateDurationMs"
      ],
      "properties": {
        "windowMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        },
        "smoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "silenceThresholdNormalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "openThresholdNormalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minStateDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "subtitleStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontSize",
        "bottomMargin"
      ],
      "properties": {
        "fontSize": {
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "bottomMargin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1920
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "voiceId",
          "lengthScale",
          "volume"
        ],
        "properties": {
          "provider": {
            "const": "elevenlabs"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
          "voiceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "lengthScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "characterTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromX",
        "toX",
        "baseY",
        "entrySeconds",
        "bobAmplitude",
        "bobPeriodSeconds",
        "baseScale",
        "scalePulse"
      ],
      "properties": {
        "fromX": {
          "type": "number",
          "minimum": -4320,
          "maximum": 4320
        },
        "toX": {
          "type": "number",
          "minimum": -4320,
          "maximum": 4320
        },
        "baseY": {
          "type": "number",
          "minimum": -3840,
          "maximum": 3840
        },
        "entrySeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "bobAmplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1920
        },
        "bobPeriodSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "baseScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "scalePulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "idleProfile": {
          "enum": [
            "breathing",
            "sway",
            "organic"
          ]
        },
        "motionSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "propTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "scale",
        "rotationDegrees",
        "opacity",
        "zIndex"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -4320,
          "maximum": 4320
        },
        "y": {
          "type": "number",
          "minimum": -3840,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "rotationDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "turnLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "x",
        "y",
        "scale"
      ],
      "properties": {
        "characterId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -4320,
          "maximum": 4320
        },
        "y": {
          "type": "number",
          "minimum": -3840,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      }
    },
    "blink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "firstSeconds",
        "minIntervalSeconds",
        "maxIntervalSeconds",
        "durationSeconds"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "firstSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "minIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "maxIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        }
      }
    },
    "animationTracks": {
      "description": "Pistas de animación por keyframes (Fase 4). El contrato está congelado en animation-scene-v1 y se referencia en vez de repetirse: una sola definición del vocabulario. Los valores de posición vienen en coordenadas de AUTORÍA (origen arriba a la izquierda); el exportador los traslada al espacio centrado del runtime.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "https://local-video.invalid/schema/animation-scene-v1.json#/$defs/track"
      }
    },
    "visibilityAnchor": {
      "description": "Referencia semantica; se resuelve tras medir el audio.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "scene"
            },
            "edge": {
              "enum": [
                "start",
                "end"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "turnId",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "turn"
            },
            "turnId": {
              "$ref": "#/$defs/id"
            },
            "edge": {
              "enum": [
                "start",
                "end"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "turnId",
            "wordIndex"
          ],
          "properties": {
            "kind": {
              "const": "word"
            },
            "turnId": {
              "$ref": "#/$defs/id"
            },
            "wordIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        }
      ]
    },
    "visibilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor",
            "offsetSeconds"
          ],
          "properties": {
            "anchor": {
              "$ref": "#/$defs/visibilityAnchor"
            },
            "offsetSeconds": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor",
            "offsetSeconds"
          ],
          "properties": {
            "anchor": {
              "$ref": "#/$defs/visibilityAnchor"
            },
            "offsetSeconds": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          }
        }
      }
    }
  }
}
