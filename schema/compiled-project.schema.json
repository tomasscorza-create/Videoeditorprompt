{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/compiled-project-v1.json",
  "title": "Proyecto compilado a escenas v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobId", "projectId", "projectVersion", "project", "resourceCatalog", "video", "projectSha256", "catalogSha256", "sourceHashes", "semanticHash", "scenes", "compiler"],
  "properties": {
    "version": { "const": 1 },
    "jobId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "projectVersion": { "const": 1 },
    "project": { "$ref": "#/$defs/assetPath" },
    "resourceCatalog": { "$ref": "#/$defs/assetPath" },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 }
      }
    },
    "projectSha256": { "$ref": "#/$defs/hash" },
    "catalogSha256": { "$ref": "#/$defs/hash" },
    "sourceHashes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/assetPath" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "semanticHash": { "$ref": "#/$defs/hash" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/compiledScene" }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "supportedElements", "supportedCharacterCount", "supportedTransitions"],
      "properties": {
        "version": { "const": 1 },
        "supportedElements": { "type": "array", "const": ["character"] },
        "supportedCharacterCount": { "const": 2 },
        "supportedTransitions": { "type": "array", "const": ["cut", "fade"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "assetPath": { "type": "string", "minLength": 1, "maxLength": 512 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "durationSeconds"],
      "properties": {
        "preset": { "enum": ["cut", "fade"] },
        "durationSeconds": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId", "resourceId", "characterAssetId"],
      "properties": {
        "elementId": { "$ref": "#/$defs/id" },
        "resourceId": { "$ref": "#/$defs/id" },
        "characterAssetId": { "$ref": "#/$defs/id" }
      }
    },
    "compiledScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "title", "config", "configSha256", "bindings"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "config": { "$ref": "#/$defs/assetPath" },
        "configSha256": { "$ref": "#/$defs/hash" },
        "bindings": { "type": "array", "minItems": 0, "maxItems": 2, "items": { "$ref": "#/$defs/binding" } },
        "transitionToNext": { "$ref": "#/$defs/transition" }
      }
    }
  }
}
