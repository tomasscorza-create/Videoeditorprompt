{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/storage-migration-plan-v1.json",
  "title": "Plan inmutable de migración de persistencia local",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "format",
    "createdAt",
    "source",
    "destination",
    "summary",
    "items",
    "fingerprint"
  ],
  "properties": {
    "version": { "const": 1 },
    "format": { "const": "local-video-storage-migration-plan" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "fingerprint", "summary"],
      "properties": {
        "format": { "const": "local-video-data-bundle" },
        "fingerprint": { "$ref": "#/$defs/hash" },
        "summary": { "type": "object" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "blobs", "blobKeyPolicy"],
      "properties": {
        "metadata": { "const": "postgresql" },
        "blobs": { "const": "s3" },
        "blobKeyPolicy": { "const": "sha256-v1" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "resources", "jobs", "blobs", "blobBytes", "items"],
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "resources": { "type": "integer", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "blobs": { "type": "integer", "minimum": 0 },
        "blobBytes": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/metadataItem" },
          { "$ref": "#/$defs/blobItem" }
        ]
      }
    },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\:/][^\\\\:]*$"
    },
    "metadataItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sourcePath",
        "sourceSha256",
        "metadataSha256",
        "target",
        "action"
      ],
      "properties": {
        "kind": { "enum": ["project-metadata", "resource-metadata", "job-metadata"] },
        "id": { "$ref": "#/$defs/id" },
        "sourcePath": { "$ref": "#/$defs/portablePath" },
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "metadataSha256": { "$ref": "#/$defs/hash" },
        "target": { "$ref": "#/$defs/portablePath" },
        "action": { "const": "planned" }
      }
    },
    "blobItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "sourcePaths",
        "bytes",
        "sha256",
        "mimeType",
        "target",
        "action"
      ],
      "properties": {
        "kind": { "const": "blob" },
        "key": { "$ref": "#/$defs/portablePath" },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target": { "$ref": "#/$defs/portablePath" },
        "action": { "const": "planned" }
      }
    }
  }
}
