{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/parametric-resource-v3.json",
  "title": "Definición paramétrica de recurso animable (v3)",
  "description": "Entrada del compilador de recursos v3. A diferencia de la definición v1, las primitivas se agrupan en piezas con pivote y jerarquía, cada una rasterizada en su propia capa. Las primitivas se reutilizan del contrato v1 para no duplicar el vocabulario geométrico.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "kind", "canvas", "pivot", "variants", "parts", "parameters", "bindings", "provenance"],
  "properties": {
    "version": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["character", "prop"] },
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "const": 1080 }, "height": { "const": 1920 } }
    },
    "pivot": { "$ref": "#/$defs/point" },
    "variants": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "outputId", "label", "palette"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "outputId": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "palette": { "$ref": "#/$defs/palette" }
        }
      }
    },
    "parts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/part" } },
    "states": { "$ref": "#/$defs/states" },
    "poses": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "$ref": "#/$defs/pose" } },
    "parameters": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/parameter" } },
    "bindings": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/binding" } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "kind": { "const": "character" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "required": ["states", "poses"],
        "properties": {
          "states": { "$ref": "#/$defs/states" },
          "poses": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "$ref": "#/$defs/pose" } }
        }
      },
      "else": {
        "type": "object",
        "properties": { "states": false, "poses": false }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "palette": {
      "type": "object", "minProperties": 1, "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$" },
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
    },
    "shapeList": { "$ref": "https://local-video.invalid/schema/parametric-character-v1.json#/$defs/shapeList" },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentId", "pivot", "zIndex", "shapes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "pivot": { "$ref": "#/$defs/point" },
        "zIndex": { "type": "integer", "minimum": -100, "maximum": 100 },
        "shapes": { "$ref": "#/$defs/shapeList" }
      }
    },
    "states": {
      "type": "object", "additionalProperties": false, "required": ["eyes", "mouth"],
      "properties": {
        "eyes": {
          "type": "object", "additionalProperties": false, "required": ["open", "closed"],
          "properties": { "open": { "$ref": "#/$defs/shapeList" }, "closed": { "$ref": "#/$defs/shapeList" } }
        },
        "mouth": {
          "type": "object", "minProperties": 3, "maxProperties": 6,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/shapeList" }
        }
      }
    },
    "pose": {
      "type": "object", "additionalProperties": false, "required": ["id", "parts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parts": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["partId", "rotationDegrees"],
            "properties": { "partId": { "$ref": "#/$defs/id" }, "rotationDegrees": { "type": "number", "minimum": -180, "maximum": 180 } }
          }
        }
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["id", "minimum", "maximum", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "minimum": { "type": "number", "minimum": -3840, "maximum": 3840 },
        "maximum": { "type": "number", "minimum": -3840, "maximum": 3840 },
        "default": { "type": "number", "minimum": -3840, "maximum": 3840 }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["parameterId", "partId", "channel", "from", "to"],
      "properties": {
        "parameterId": { "$ref": "#/$defs/id" },
        "partId": { "$ref": "#/$defs/id" },
        "channel": { "enum": ["rotationDegrees", "offsetX", "offsetY", "scale", "opacity"] },
        "from": { "type": "number", "minimum": -3840, "maximum": 3840 },
        "to": { "type": "number", "minimum": -3840, "maximum": 3840 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "license"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
