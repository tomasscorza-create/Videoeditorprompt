{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/ai-video-plan-v2.json",
  "title": "Plan flexible del Director IA V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "tone", "targetDurationSeconds", "richnessProfile", "scenes"],
  "properties": {
    "version": { "const": 2 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "tone": { "enum": ["educational", "ironic", "serious", "energetic", "inspirational"] },
    "targetDurationSeconds": { "type": "integer", "minimum": 8, "maximum": 90 },
    "richnessProfile": { "enum": ["automatic", "simple", "varied", "dynamic"] },
    "narrativeTemplateId": { "$ref": "#/$defs/id" },
    "musicResourceId": { "$ref": "#/$defs/id" },
    "scenes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["roleId", "characterResourceId", "voiceId", "animationPresetId"],
      "properties": {
        "roleId": { "$ref": "#/$defs/id" },
        "characterResourceId": { "$ref": "#/$defs/id" },
        "voiceId": { "$ref": "#/$defs/id" },
        "animationPresetId": { "$ref": "#/$defs/id" }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["roleId", "type", "resourceId"],
      "properties": {
        "roleId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["prop", "template"] },
        "resourceId": { "$ref": "#/$defs/id" },
        "word": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "characterTurn": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "speakerRoleId", "text", "gestureId", "gapAfterSeconds"],
      "properties": {
        "kind": { "const": "character" },
        "speakerRoleId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "gestureId": { "enum": ["neutral", "point", "celebrate", "doubt", "deny"] },
        "gestureAtWord": { "type": "integer", "minimum": 0, "maximum": 99 },
        "pace": { "enum": ["slow", "normal", "fast"] },
        "gapAfterSeconds": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "voiceoverTurn": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voiceId", "text", "gapAfterSeconds"],
      "properties": {
        "kind": { "const": "voiceover" },
        "voiceId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "pace": { "enum": ["slow", "normal", "fast"] },
        "gapAfterSeconds": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "purpose", "mode", "durationWeight", "sceneRecipeId", "backgroundResourceId", "cameraPreset", "layoutPreset", "transitionPreset", "transitionDurationSeconds", "participants", "visualElements", "speech"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mode": { "enum": ["voiceover", "solo", "dialogue", "visual-with-voiceover"] },
        "durationWeight": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "sceneRecipeId": { "$ref": "#/$defs/id" },
        "effectSequenceIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "backgroundResourceId": { "$ref": "#/$defs/id" },
        "cameraPreset": { "enum": ["static", "slow-pan", "slow-zoom"] },
        "layoutPreset": { "$ref": "#/$defs/id" },
        "transitionPreset": { "enum": ["cut", "fade"] },
        "transitionDurationSeconds": { "type": "number", "minimum": 0, "maximum": 1 },
        "participants": { "type": "array", "minItems": 0, "maxItems": 2, "items": { "$ref": "#/$defs/participant" } },
        "visualElements": { "type": "array", "minItems": 0, "maxItems": 4, "items": { "$ref": "#/$defs/visual" } },
        "speech": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "oneOf": [{ "$ref": "#/$defs/characterTurn" }, { "$ref": "#/$defs/voiceoverTurn" }] } }
      }
    }
  }
}
