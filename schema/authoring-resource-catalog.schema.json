{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/authoring-resource-catalog-v1.json",
  "title": "Catálogo de recursos de autoría",
  "description": "Índice portable de recursos seleccionables por el editor o por un plan generado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/characterResource" },
          { "$ref": "#/$defs/voiceResource" },
          { "$ref": "#/$defs/backgroundResource" },
          { "$ref": "#/$defs/imageResource" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "assetPath": { "type": "string", "minLength": 1, "maxLength": 512 },
    "label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tags": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "license": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "characterResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "tags", "characterRef", "capabilities", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "character" },
        "label": { "$ref": "#/$defs/label" },
        "tags": { "$ref": "#/$defs/tags" },
        "characterRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog", "entryId"],
          "properties": {
            "catalog": { "$ref": "#/$defs/assetPath" },
            "entryId": { "$ref": "#/$defs/id" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["poses", "animationPresets"],
          "properties": {
            "poses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "animationPresets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "voiceResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "tags", "voice", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "voice" },
        "label": { "$ref": "#/$defs/label" },
        "tags": { "$ref": "#/$defs/tags" },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "locale", "lengthScale", "volume"],
          "properties": {
            "provider": { "const": "piper" },
            "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
            "locale": { "type": "string", "pattern": "^[a-z]{2}_[A-Z]{2}$" },
            "lengthScale": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "volume": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "backgroundResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "tags", "backgroundManifest", "capabilities", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "background" },
        "label": { "$ref": "#/$defs/label" },
        "tags": { "$ref": "#/$defs/tags" },
        "backgroundManifest": { "$ref": "#/$defs/assetPath" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cameraPresets"],
          "properties": {
            "cameraPresets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "imageResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "tags", "asset", "thumbnail", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "image" },
        "label": { "$ref": "#/$defs/label" },
        "tags": { "$ref": "#/$defs/tags" },
        "asset": { "$ref": "#/$defs/assetPath" },
        "thumbnail": { "$ref": "#/$defs/assetPath" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
