{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/narrative-template-catalog-v1.json",
  "title": "Catálogo de plantillas narrativas del Director IA",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "version": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 180 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "speaker", "pace", "layouts", "gestures"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "intent": { "$ref": "#/$defs/shortText" },
        "speaker": { "enum": ["a", "b", "either", "both"] },
        "pace": { "enum": ["slow", "normal", "fast"] },
        "layouts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "gestures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "tags", "tones", "sceneRange", "beats", "musicTags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "$ref": "#/$defs/shortText" },
        "tags": { "$ref": "#/$defs/tags" },
        "tones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["educational", "ironic", "serious", "energetic", "inspirational"] }
        },
        "sceneRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1, "maximum": 4 },
            "max": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "beats": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/beat" }
        },
        "musicTags": { "$ref": "#/$defs/tags" }
      }
    }
  }
}
