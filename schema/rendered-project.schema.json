{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/rendered-project-v1.json",
  "title": "Resultado multiescena renderizado",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobId", "projectId", "compiledProject", "compiledSemanticHash", "video", "timeline", "outputs", "deterministic", "verification"],
  "properties": {
    "version": { "const": 1 },
    "jobId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "compiledProject": { "$ref": "#/$defs/portablePath" },
    "compiledSemanticHash": { "$ref": "#/$defs/hash" },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "scenes"],
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 960 },
        "scenes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/renderedScene" } }
      }
    },
    "verificationMode": { "enum": ["full", "interactive"] },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/output" }
    },
    "deterministic": { "type": "boolean" },
    "verification": { "$ref": "#/$defs/portablePath" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
    "portablePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\:]+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "durationSeconds", "startSeconds", "endSeconds"],
      "properties": {
        "preset": { "enum": ["cut", "fade"] },
        "durationSeconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "startSeconds": { "type": "number", "minimum": 0, "maximum": 960 },
        "endSeconds": { "type": "number", "minimum": 0, "maximum": 960 }
      }
    },
    "renderedScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "sceneJobId", "config", "runtime", "render1", "audioDurationSeconds", "renderDurationSeconds", "startSeconds", "endSeconds", "verificationPassed"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "id": { "$ref": "#/$defs/id" },
        "sceneJobId": { "$ref": "#/$defs/id" },
        "config": { "$ref": "#/$defs/portablePath" },
        "runtime": { "$ref": "#/$defs/portablePath" },
        "render1": { "$ref": "#/$defs/portablePath" },
        "render2": { "$ref": "#/$defs/portablePath" },
        "audioDurationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "renderDurationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "startSeconds": { "type": "number", "minimum": 0, "maximum": 960 },
        "endSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 960 },
        "verificationPassed": { "type": "integer", "minimum": 1 },
        "transitionToNext": { "$ref": "#/$defs/transition" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runNumber", "file", "sha256", "bytes", "durationSeconds"],
      "properties": {
        "runNumber": { "type": "integer", "minimum": 1, "maximum": 2 },
        "file": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 960 }
      }
    }
  }
}
