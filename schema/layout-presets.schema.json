{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/layout-presets-v1.json",
  "title": "Catálogo de composiciones (layouts) del Director IA",
  "description": "Vocabulario de layouts como datos: cada preset ubica los dos personajes por ID, sin coordenadas libres en la propuesta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "version": { "const": 1 },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "slots"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": { "$ref": "#/$defs/slot" },
            "b": { "$ref": "#/$defs/slot" }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scale", "zIndex"],
      "properties": {
        "x": { "type": "number", "minimum": -1080, "maximum": 2160 },
        "y": { "type": "number", "minimum": -1920, "maximum": 3840 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "zIndex": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      }
    }
  }
}
