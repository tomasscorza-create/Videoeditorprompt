{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/local-character-design.json",
  "title": "Diseño local de personaje",
  "oneOf": [
    { "$ref": "#/$defs/templateDesign" },
    { "$ref": "#/$defs/customDesign" }
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline", "fur", "lightFur", "suit", "shirt", "accent", "white", "mouthDark", "tongue", "shadow"],
      "properties": {
        "outline": { "$ref": "#/$defs/color" },
        "fur": { "$ref": "#/$defs/color" },
        "lightFur": { "$ref": "#/$defs/color" },
        "suit": { "$ref": "#/$defs/color" },
        "shirt": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "white": { "$ref": "#/$defs/color" },
        "mouthDark": { "$ref": "#/$defs/color" },
        "tongue": { "$ref": "#/$defs/color" },
        "shadow": { "$ref": "#/$defs/color" }
      }
    },
    "templateDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "preset", "name", "accessory", "headwear", "palette"],
      "properties": {
        "version": { "const": 1 },
        "preset": { "const": "mono-parametrico-v1" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "accessory": { "enum": ["none", "glasses", "badge"] },
        "headwear": { "enum": ["none", "cap"] },
        "palette": { "$ref": "#/$defs/palette" }
      }
    },
    "customDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "name", "parts"],
      "properties": {
        "version": { "const": 2 },
        "mode": { "const": "from-scratch" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "parts": {
          "type": "array",
          "minItems": 9,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/part" }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "shape", "x", "y", "width", "height", "rotationDegrees", "fill", "stroke", "strokeWidth"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "role": {
          "enum": [
            "body", "head", "eye-left", "eye-right", "mouth",
            "arm-left", "arm-right", "leg-left", "leg-right",
            "garment", "accessory"
          ]
        },
        "shape": { "enum": ["ellipse", "rect"] },
        "x": { "type": "number", "minimum": 0, "maximum": 1080 },
        "y": { "type": "number", "minimum": 0, "maximum": 1920 },
        "width": { "type": "number", "minimum": 10, "maximum": 1080 },
        "height": { "type": "number", "minimum": 10, "maximum": 1920 },
        "rotationDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 80 }
      }
    }
  }
}
