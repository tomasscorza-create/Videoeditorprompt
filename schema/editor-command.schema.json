{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video.invalid/schema/editor-command-v1.json",
  "title": "Comando semántico del editor local",
  "oneOf": [
    {
      "$ref": "#/$defs/selectScene"
    },
    {
      "$ref": "#/$defs/setProjectTitle"
    },
    {
      "$ref": "#/$defs/setSceneTitle"
    },
    {
      "$ref": "#/$defs/addScene"
    },
    {
      "$ref": "#/$defs/duplicateScene"
    },
    {
      "$ref": "#/$defs/deleteScene"
    },
    {
      "$ref": "#/$defs/setSceneBackground"
    },
    {
      "$ref": "#/$defs/setCharacterResource"
    },
    {
      "$ref": "#/$defs/setCharacterAnimation"
    },
    {
      "$ref": "#/$defs/addCharacter"
    },
    {
      "$ref": "#/$defs/addProp"
    },
    {
      "$ref": "#/$defs/setPropResource"
    },
    {
      "$ref": "#/$defs/addTemplate"
    },
    {
      "$ref": "#/$defs/setTemplateWord"
    },
    {
      "$ref": "#/$defs/deleteElement"
    },
    {
      "$ref": "#/$defs/placeCharacterResource"
    },
    {
      "$ref": "#/$defs/setCharacterTransform"
    },
    {
      "$ref": "#/$defs/setElementTransform"
    },
    {
      "$ref": "#/$defs/setDialogueTurn"
    },
    {
      "$ref": "#/$defs/addDialogueTurn"
    },
    {
      "$ref": "#/$defs/addVoiceoverTurn"
    },
    {
      "$ref": "#/$defs/deleteDialogueTurn"
    },
    {
      "$ref": "#/$defs/setDialogueSpeaker"
    },
    {
      "$ref": "#/$defs/setDialogueVoiceover"
    },
    {
      "$ref": "#/$defs/setTransition"
    },
    {
      "$ref": "#/$defs/reorderScenes"
    },
    {
      "$ref": "#/$defs/splitScene"
    },
    {
      "$ref": "#/$defs/splitDialogueTurn"
    },
    {
      "$ref": "#/$defs/reorderDialogueTurns"
    },
    {
      "$ref": "#/$defs/addKeyframe"
    },
    {
      "$ref": "#/$defs/setKeyframe"
    },
    {
      "$ref": "#/$defs/deleteKeyframe"
    },
    {
      "$ref": "#/$defs/deleteTrack"
    },
    {
      "$ref": "#/$defs/createTrack"
    },
    {
      "$ref": "#/$defs/applyAnimationPreset"
    },
    {
      "$ref": "#/$defs/removeAnimation"
    },
    {
      "$ref": "#/$defs/setElementWindow"
    },
    {
      "$ref": "#/$defs/clearElementWindow"
    },
    {
      "$ref": "#/$defs/splitElement"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "selectScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId"
      ],
      "properties": {
        "type": {
          "const": "select-scene"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setProjectTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "set-project-title"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "setSceneTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "title"
      ],
      "properties": {
        "type": {
          "const": "set-scene-title"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "addScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "scene"
      ],
      "properties": {
        "type": {
          "const": "add-scene"
        },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "background",
            "elements",
            "dialogue"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "background": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resourceId",
                "cameraPreset"
              ],
              "properties": {
                "resourceId": {
                  "$ref": "#/$defs/id"
                },
                "cameraPreset": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "elements": {
              "type": "array",
              "maxItems": 0
            },
            "dialogue": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      }
    },
    "duplicateScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "newSceneId",
        "title"
      ],
      "properties": {
        "type": {
          "const": "duplicate-scene"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "newSceneId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "deleteScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId"
      ],
      "properties": {
        "type": {
          "const": "delete-scene"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setSceneBackground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "resourceId",
        "cameraPreset"
      ],
      "properties": {
        "type": {
          "const": "set-scene-background"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "cameraPreset": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setCharacterResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "resourceId"
      ],
      "properties": {
        "type": {
          "const": "set-character-resource"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setCharacterAnimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "animationPreset"
      ],
      "properties": {
        "type": {
          "const": "set-character-animation"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "animationPreset": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "addCharacter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "resourceId",
        "x",
        "y",
        "scale",
        "zIndex"
      ],
      "properties": {
        "type": {
          "const": "add-character"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1080,
          "maximum": 2160
        },
        "y": {
          "type": "number",
          "minimum": -1920,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "addProp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "resourceId",
        "x",
        "y",
        "scale",
        "zIndex"
      ],
      "properties": {
        "type": {
          "const": "add-prop"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1080,
          "maximum": 2160
        },
        "y": {
          "type": "number",
          "minimum": -1920,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "addTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "templateId",
        "word",
        "zIndex"
      ],
      "properties": {
        "type": {
          "const": "add-template"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "templateId": {
          "$ref": "#/$defs/id"
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "setTemplateWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "word"
      ],
      "properties": {
        "type": {
          "const": "set-template-word"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "setPropResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "resourceId"
      ],
      "properties": {
        "type": {
          "const": "set-prop-resource"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deleteElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId"
      ],
      "properties": {
        "type": {
          "const": "delete-element"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "placeCharacterResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId",
        "resourceId",
        "x",
        "y"
      ],
      "properties": {
        "type": {
          "const": "place-character-resource"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1080,
          "maximum": 2160
        },
        "y": {
          "type": "number",
          "minimum": -1920,
          "maximum": 3840
        }
      }
    },
    "setCharacterTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId"
      ],
      "anyOf": [
        {
          "properties": {
            "x": true
          },
          "required": [
            "x"
          ]
        },
        {
          "properties": {
            "y": true
          },
          "required": [
            "y"
          ]
        },
        {
          "properties": {
            "scale": true
          },
          "required": [
            "scale"
          ]
        },
        {
          "properties": {
            "zIndex": true
          },
          "required": [
            "zIndex"
          ]
        }
      ],
      "properties": {
        "type": {
          "const": "set-character-transform"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1080,
          "maximum": 2160
        },
        "y": {
          "type": "number",
          "minimum": -1920,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "setElementTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "elementId"
      ],
      "minProperties": 4,
      "properties": {
        "type": {
          "const": "set-element-transform"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1080,
          "maximum": 2160
        },
        "y": {
          "type": "number",
          "minimum": -1920,
          "maximum": 3840
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "rotationDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "setDialogueTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId"
      ],
      "anyOf": [
        {
          "properties": {
            "text": true
          },
          "required": [
            "text"
          ]
        },
        {
          "properties": {
            "voiceId": true
          },
          "required": [
            "voiceId"
          ]
        },
        {
          "properties": {
            "gestureId": true
          },
          "required": [
            "gestureId"
          ]
        },
        {
          "properties": {
            "gestureAtWord": true
          },
          "required": [
            "gestureAtWord"
          ]
        },
        {
          "properties": {
            "pace": true
          },
          "required": [
            "pace"
          ]
        },
        {
          "properties": {
            "layoutPreset": true
          },
          "required": [
            "layoutPreset"
          ]
        },
        {
          "properties": {
            "gapAfterSeconds": true
          },
          "required": [
            "gapAfterSeconds"
          ]
        }
      ],
      "properties": {
        "type": {
          "const": "set-dialogue-turn"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "voiceId": {
          "$ref": "#/$defs/id"
        },
        "gestureId": {
          "enum": [
            "neutral",
            "point",
            "celebrate",
            "doubt",
            "deny"
          ]
        },
        "gestureAtWord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "pace": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "layoutPreset": {
          "enum": [
            "balanced",
            "focus-a",
            "focus-b",
            "close-up-a",
            "close-up-b",
            "wide",
            "stacked"
          ]
        },
        "gapAfterSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "addDialogueTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId",
        "speakerElementId",
        "text",
        "voiceId",
        "gestureId",
        "gapAfterSeconds"
      ],
      "properties": {
        "type": {
          "const": "add-dialogue-turn"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        },
        "speakerElementId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "voiceId": {
          "$ref": "#/$defs/id"
        },
        "gestureId": {
          "enum": [
            "neutral",
            "point",
            "celebrate",
            "doubt",
            "deny"
          ]
        },
        "gestureAtWord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "pace": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "layoutPreset": {
          "enum": [
            "balanced",
            "focus-a",
            "focus-b",
            "close-up-a",
            "close-up-b",
            "wide",
            "stacked"
          ]
        },
        "gapAfterSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "afterTurnId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "addVoiceoverTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId",
        "text",
        "voiceId",
        "gapAfterSeconds"
      ],
      "properties": {
        "type": {
          "const": "add-voiceover-turn"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "voiceId": {
          "$ref": "#/$defs/id"
        },
        "pace": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "gapAfterSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "afterTurnId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "deleteDialogueTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId"
      ],
      "properties": {
        "type": {
          "const": "delete-dialogue-turn"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setDialogueSpeaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId",
        "speakerElementId"
      ],
      "properties": {
        "type": {
          "const": "set-dialogue-speaker"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        },
        "speakerElementId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setDialogueVoiceover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "turnId"
      ],
      "properties": {
        "type": {
          "const": "set-dialogue-voiceover"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "turnId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "preset",
        "durationSeconds"
      ],
      "properties": {
        "type": {
          "const": "set-transition"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "preset": {
          "enum": [
            "cut",
            "fade"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "reorderScenes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneIds"
      ],
      "properties": {
        "type": {
          "const": "reorder-scenes"
        },
        "sceneIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "splitScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sceneId",
        "atTurnId",
        "newSceneId"
      ],
      "properties": {
        "type": {
          "const": "split-scene"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "atTurnId": {
          "$ref": "#/$defs/id"
        },
        "newSceneId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "splitDialogueTurn": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parte un turno en dos por una frontera de palabra. Es el único corte de audio que el contrato admite: cada turno se sintetiza entero, así que cortar significa producir dos enunciados que Piper vuelve a medir, nunca recortar un WAV.",
